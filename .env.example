# =============================================================================
# opencti-ai-enrichment — example configuration
# =============================================================================
# Copy to .env and fill in the three required values. Everything else has a
# working default.
#
#   cp .env.example .env
#
# .env is git-ignored. Do not commit it.
#
# The defaults below are deliberately the SAFE ones: AI_READ_ONLY=true means the
# connector runs the complete analysis pipeline and writes nothing at all to the
# knowledge graph. That is the posture you want for the first several weeks —
# long enough to read the audit log and decide, per entity category, whether the
# model has earned write access. See docs/CONFIGURATION.md and DESIGN.md.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — the connector exits immediately if any of these is missing
# -----------------------------------------------------------------------------

# Google AI Studio / Gemini API key.
GEMINI_API_KEY=

# OpenCTI API token for a user with the permissions the connector needs.
# In READ_ONLY mode a read-only token is sufficient, and is what you should use.
OPENCTI_TOKEN=

# A UUIDv4 you generate once, unique to this connector instance. OpenCTI uses it
# as the connector's stable identity across restarts.
#   python -c "import uuid; print(uuid.uuid4())"
CONNECTOR_ID=


# -----------------------------------------------------------------------------
# OpenCTI connection
# -----------------------------------------------------------------------------

OPENCTI_URL=http://localhost:8080
CONNECTOR_NAME=AI Enrichment (Gemini)

# true  = OpenCTI invokes the connector automatically on in-scope entities
# false = enrichment only runs when a human asks for it from the UI
# Start with false. Automatic invocation across a live feed is how you discover
# your rate limits the expensive way.
CONNECTOR_AUTO=false

CONNECTOR_LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Model selection and routing
# -----------------------------------------------------------------------------

# Two-tier routing: the HIGH model handles Reports, Intrusion-Sets and Campaigns
# and anything whose own content exceeds the routing threshold; the LOW model
# handles everything else and every critic pass.
GEMINI_MODEL_HIGH=gemini-3.6-flash
GEMINI_MODEL_LOW=gemini-3.6-flash
GEMINI_MODEL_ROUTING_THRESHOLD=2000

# Google Search grounding: auto | always | never
# Set this to never if you fetch external references instead (AI_FETCH_REFS),
# which is the recommended configuration — see DESIGN.md on why fetching beat
# grounding. Search grounding also cannot be combined with forced-JSON mode.
GEMINI_ENABLE_SEARCH=never
GEMINI_SEARCH_CONTENT_FLOOR=500


# -----------------------------------------------------------------------------
# Write guardrails — the part that matters
# -----------------------------------------------------------------------------

# Master switch. true = analyse everything, write nothing. Would-create and
# would-link decisions are still counted and logged in full, so a read-only run
# produces exactly the evidence you need to judge the model.
AI_READ_ONLY=true

# Global creation default: off | dry-run | on
#   off      never create; link only to entities that already exist
#   dry-run  do not create, but log precisely what would have been created
#   on       create the missing entity, tagged with AI_REVIEW_LABEL
AI_CREATE_STUBS=dry-run

# Per-category overrides. Unset = inherit AI_CREATE_STUBS. This is the unit of
# promotion: enable one category at a time, once you have seen how it behaves on
# your own sources, and leave the rest where they are.
# AI_CREATE_ACTORS=off
# AI_CREATE_MALWARE=off
# AI_CREATE_TOOLS=off
# AI_CREATE_VICTIMS=off

# Sectors are lookup-only by default against the curated sector vocabulary.
# Free-text sector creation is what fragments a taxonomy: an unchecked feed
# turns a couple of dozen canonical sectors into several hundred near-duplicates.
AI_CREATE_SECTORS=false

# Refuse to CREATE an entity whose name is not traceable to the analysed source
# text. Deterministic, no extra model call. Linking to existing entities is
# unaffected. Leave this on.
AI_REQUIRE_GROUNDING=true

# Attack-Patterns and CVEs have no creation switch at all. They are permanently
# lookup-only against MITRE ATT&CK and NVD. That is a deliberate reversal made
# after watching both fail, not an oversight — see DESIGN.md and OBSERVATIONS.md.


# -----------------------------------------------------------------------------
# What gets written when writes are enabled
# -----------------------------------------------------------------------------

# Maximum characters of entity content sent to the model.
AI_CONTENT_LIMIT=8000

# Structured field enrichment (motivation, malware_types, CVSS, ...).
AI_ENRICH_FIELDS=true

AI_APPLY_SUGGESTED_LABELS=true
AI_MAX_LABELS=10

# Applied to entities the connector has already enriched. This is the idempotency
# marker: it is how a re-run knows not to enrich the same entity twice.
AI_IDEMPOTENCY_LABEL=ai-enriched

# Applied to anything the connector created rather than found. Everything the AI
# introduces stays queryable and reversible by this one label.
AI_REVIEW_LABEL=ai-suggested

# Write aliases the model discovers back onto the entity being enriched, so
# future name matching improves. Off by default: it edits existing entities.
AI_ALIAS_WRITEBACK=false


# -----------------------------------------------------------------------------
# Confidence
# -----------------------------------------------------------------------------

# Decay confidence with the age of the source material.
AI_CONFIDENCE_DECAY_ENABLED=true

# Flat correction applied to model confidence, -50..50. Use this only with a
# measurement in hand.
AI_CONFIDENCE_CALIBRATION_OFFSET=0

# Skip auto-enrichment of standalone Vulnerabilities below this CVSS base score.
# 0 = no gating. Summarising every NVD CVE is low graph value.
AI_MIN_CVSS=0


# -----------------------------------------------------------------------------
# Critic pass
# -----------------------------------------------------------------------------

# A second, cheap LOW-model call reviews the extracted entities and flags
# mis-typed, generic, junk and victim-as-actor items before anything is linked
# or created. Off by default because it costs a second call per enrichment.
AI_CRITIC_ENABLED=false


# -----------------------------------------------------------------------------
# External reference fetching
# -----------------------------------------------------------------------------

# Fetch the linked source article and give the model its text. Costs no model
# quota and is deterministic: you control exactly what the model sees.
# Auth-gated portals are detected and skipped.
AI_FETCH_REFS=true
AI_FETCH_TIMEOUT=10
AI_FETCH_MAX_REFS=3
AI_FETCH_MAX_CHARS_PER_REF=4000
AI_FETCH_MAX_BYTES=400000


# -----------------------------------------------------------------------------
# Pacing
# -----------------------------------------------------------------------------

# Client-side requests-per-minute cap. 0 = no pacing. Without pacing a busy feed
# produces 429 storms where every rejected call costs a long backoff sleep, so
# throughput collapses to well below the quota you were trying to use.
AI_MAX_RPM=0


# -----------------------------------------------------------------------------
# Durable audit trail
# -----------------------------------------------------------------------------

# Container logs die with the container and metrics live in memory, so a redeploy
# erases the evidence of how the connector behaved. Point this at a bind-mounted
# path and every log line is mirrored there, with each metrics summary appended
# as a JSON line to ai_metrics.jsonl beside it.
#
# NOTE: the audit log contains real entity names from your graph. It is
# git-ignored for that reason. Treat it as graph data.
AI_AUDIT_LOG=/state/ai_audit.log
AI_AUDIT_LOG_MAX_MB=64
