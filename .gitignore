# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Runtime output: audit trail and metrics contain real graph content ---
*.log
ai_audit.log*
ai_metrics.jsonl
state/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtualenvs ---
.venv/
venv/
env/
ENV/

# --- Test and coverage ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# --- Scratch files used to pass multi-line commit messages to git -F ---
# PowerShell has no heredoc, so these get written next to the repo and deleted.
# Ignored so a `git add -A` cannot sweep one into a commit.
_*.tmp

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
